# Neon PostgreSQL (https://neon.tech) — optional
# Without DATABASE_URL the shop runs on seed data + browser localStorage.
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require

# Auth.js (NextAuth) — admin login
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@your-domain.dz
ADMIN_PASSWORD=change-me

# Marketing pixels (optional — paste IDs to enable tracking)
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
